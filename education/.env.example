# Config de ambiente TESTING. Copiar a ".env.testing" (para correr con
# `go run` sin Docker) o a ".env" (para docker-compose) y completar los
# valores reales.
#
# APP_ENV=testing solo puede combinarse con CONTENTFUL_ENVIRONMENT=testing.
# Cualquier otra combinación hace que el servicio rechace arrancar
# (ver validateEnvironmentSafety en internal/config/config.go).

PORT=
APP_ENV=

CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=
CONTENTFUL_CDA_TOKEN=
CONTENTFUL_CMA_TOKEN=
CONTENTFUL_LOCALE=

CORS_ALLOWED_ORIGINS=

# URL base de auth-service (ej. http://auth-service:8080 en Docker o http://localhost:8082 fuera).
# Obligatoria en producción para interactuar con participantes y asistencias.
AUTH_SERVICE_URL=
# Activa tokens de identidad para Cloud Run privado (true en GCP, vacío/false en local).
UPSTREAM_ID_TOKEN=

JWT_SECRET=


GOOGLE_APPLICATION_CREDENTIALS=

# Bucket privado de Cloud Storage para los adjuntos de las entregas de
# actividades (mismo proyecto y service account que Firestore). Vacío =
# se aceptan entregas solo con texto.
ENTREGAS_BUCKET=

# Cloudflare Worker para Impacto
WORKER_IMPACT_URL=
WORKER_SYNC_TOKEN=
# Sugerencia de habilidades con IA (HU-21 / HU-58). Todo opcional: sin
# esto el servicio arranca igual y las habilidades se cargan a mano.
# Ver docs/ia-habilidades.md.
#
# Gemini (principal), vía Vertex AI. NO lleva API key: usa la misma
# service account que Firestore, que necesita el rol "Vertex AI User".
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# OpenAI (respaldo). En Cloud Run, inyectar desde Secret Manager; nunca
# escribir la clave en el repo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tiempo máximo por intento (segundos, tope 60) y reintentos por
# proveedor ante fallas pasajeras (tope 3).
SKILLS_AI_TIMEOUT_SECONDS=20
SKILLS_AI_MAX_RETRIES=1

# ── Mensajería asíncrona con Pub/Sub (docs/eventos/README.md) ──
# Sin PUBSUB_PROJECT_ID el servicio no publica eventos (desarrollo local).
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC_EDUCACION=educacion-eventos
PUBSUB_TOPIC_CONTENIDO=contenido-eventos
# Push de Pub/Sub: audience = URL de este servicio en Cloud Run, y las
# service accounts que crea infra/pubsub/setup.sh. Vacías = no se
# exponen los endpoints /eventos/*. PUBSUB_PUSH_AUTH=disabled solo en
# local con el emulador (PUBSUB_EMULATOR_HOST); en producción no arranca.
PUBSUB_PUSH_AUTH=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNTS=
# Secreto del webhook de Contentful (header X-Webhook-Secret). En Cloud
# Run viene de Secret Manager. Vacío = POST /webhooks/contentful deshabilitado.
CONTENTFUL_WEBHOOK_SECRET=
# Cuánto se reusa una lectura de Contentful (0 = sin caché). Si
# Contentful falla se sirve la última versión válida (HU-17).
CONTENT_CACHE_TTL=5m
