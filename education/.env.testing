# Base de auth-service (sin path), para que education pueda resolver el
# listado de participantes/usuarios al armar la asistencia general
# (GET /api/asistencia-general). "auth-service" es el nombre del
# servicio en buenvivir-net (ver docker-compose.yml de la raíz) — solo
# resuelve corriendo con el compose de la raíz (auth + education en la
# misma red), no con education/docker-compose.yml suelto.
AUTH_SERVICE_URL=http://auth-service:8080


