PORT=8090
AUTH_SERVICE_URL=http://auth-service:8080
EDUCATION_SERVICE_URL=http://education-service:8210
LABOR_SERVICE_URL=http://labor-integration:8080
HUMAN_PROMOTION_SERVICE_URL=http://human-promotion:8085

# ── Seguridad ──
# El MISMO secreto que auth-service. Con él el Dashboard valida el token por
# su cuenta (obligatorio en Google Cloud, donde el gateway no pasa el rol).
# Vacío = confía en el X-User-Role que pone el gateway de Docker.
JWT_SECRET=
# true en Cloud Run: pide un token de identidad de Google para llamar a los
# demás servicios (que no aceptan llamadas anónimas).
UPSTREAM_ID_TOKEN=

# ── Historial de reportes (HU-55) ──
# Bucket de Cloud Storage para los PDF (carpeta reportes/) y credenciales de
# Google para Firestore y Storage. Vacío = el historial no se guarda.
REPORTES_BUCKET=ceibuenvivir-bucket
GOOGLE_APPLICATION_CREDENTIALS=

# ── Eventos de Pub/Sub (docs/eventos/README.md) ──
# Cuánto se reusa cada fuente del dashboard (0 = sin caché). Los eventos
# la invalidan antes.
DASHBOARD_CACHE_TTL=5m
# Push de Pub/Sub: audience = <URL de Cloud Run>/eventos. Vacías = no se
# expone POST /eventos. PUBSUB_PUSH_AUTH=disabled solo en local.
APP_ENV=
PUBSUB_PUSH_AUTH=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNTS=
