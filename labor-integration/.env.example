# Puerto HTTP del microservicio
PORT=8080

# Identificador del proyecto real en Google Cloud Platform (GCP)
# Dónde obtenerlo: GCP Console -> ID del Proyecto en el menú superior
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp-id

# Ruta al archivo de clave JSON de la Service Account con rol "Cloud Datastore User" o "Firestore User"
# Dónde obtenerlo: GCP Console -> IAM & Admin -> Service Accounts -> Crear Clave (JSON) y guardarla en la raíz del proyecto
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Nombre de la base de datos de Firestore en GCP (Por defecto es '(default)')
FIRESTORE_DATABASE=(default)

# Target del servidor gRPC de Auth Service para comunicación interna
AUTH_SERVICE_GRPC_TARGET=auth-service:50051

# URL base del servicio de notificaciones
NOTIFICATIONS_SERVICE_URL=http://notifications-service:8080

# Secreto compartido para autenticar eventos con notifications-service
INTERNAL_HMAC_SECRET=buenvivir-internal-hmac-secret-dev
