# Archivo de ejemplo para inyectar variables en openapi.yaml mediante CI/CD o script (ej. envsubst)
# Nota: Google API Gateway no lee .env en runtime. Deben reemplazarse antes del despliegue.

GCP_PROJECT_ID="mi-proyecto-gcp"
FIREBASE_PROJECT_ID="mi-proyecto-firebase"
GATEWAY_HOST="buenvivir-gateway.apigateway.mi-proyecto-gcp.gateway.dev"

# URLs de Cloud Run en producción
AUTH_SERVICE_URL="https://auth-service-url-cloudrun.a.run.app"
CAMPAIGNS_SERVICE_URL="https://campaigns-service-url-cloudrun.a.run.app"
