{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/app/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/app/app.config.ts",
    "!src/app/pages/dashboard/asistencia/**",
    "!src/app/pages/dashboard/campanas/**",
    "!src/app/pages/dashboard/cursos/**",
    "!src/app/pages/dashboard/cv/**",
    "!src/app/pages/dashboard/insercion/**",
    "!src/app/pages/dashboard/mis-cursos/**",
    "!src/app/pages/dashboard/notificaciones/**",
    "!src/app/pages/dashboard/ofertas/**",
    "!src/app/pages/dashboard/participantes/**",
    "!src/app/pages/dashboard/progreso/**",
    "!src/app/pages/dashboard/seguimiento/**",
    "!src/app/pages/dashboard/usuarios/**"
  ],
  "testRunner": "karma",
  "karma": {
    "configFile": "karma.conf.js",
    "projectType": "angular-cli",
    "config": {
      "browsers": ["ChromeHeadless"]
    }
  },
  "reporters": ["progress", "clear-text", "html"],
  "concurrency": 2,
  "concurrency_comment": "We use concurrency 2 to avoid overwhelming ChromeHeadless instances",
  "coverageAnalysis": "off",
  "plugins": ["@stryker-mutator/karma-runner"]
}
