PORT=8080
# Database connection for NeonDB
DATABASE_URL_AUTH=postgres://user:password@neon-host:5432/auth_db?sslmode=require

# JWT Secrets for internal authentication
JWT_SECRET=super-secret-access-key
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Firebase/Google Credentials (path to serviceAccountKey.json or base64 encoded)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Security / CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://tu-dominio.com

# Cloudflare Worker KV Impact Sync
WORKER_IMPACT_URL=https://buen-vivir-impact-staging.workers.dev/api/impact/update
WORKER_SYNC_TOKEN=your-sync-token-secret

# Notifications Service
NOTIFICATIONS_SERVICE_URL=http://notifications-service:8080

# Frontend & URLs
FRONTEND_URL=https://ceibuenvivir.org
RESET_PASSWORD_PATH=/change-password
