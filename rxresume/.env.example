# Servidor HTTP
PORT=8080

# Base de datos PostgreSQL / GORM
DATABASE_URL=postgres://postgres:postgres@localhost:5432/buenvivir_rxresume?sslmode=disable

# Instancia Autohospedada de Reactive Resume
REACTIVE_RESUME_URL=http://reactive-resume:3000
REACTIVE_RESUME_PUBLIC_URL=http://localhost:3000
REACTIVE_RESUME_SECRET_KEY=buenvivir_secret_key_123

# Almacenamiento de Objetos Google Cloud Storage (GCS)
GCP_PROJECT_ID=buenvivir-gcp-project
GCP_BUCKET_NAME=buenvivir-resumes-bucket
GCP_EMULATOR_HOST=http://gcs-emulator:4443
GOOGLE_APPLICATION_CREDENTIALS=

# Integración con Servicio de Autenticación & API Gateway
AUTH_SERVICE_URL=http://auth-service:8080
PUBLIC_API_URL=http://localhost:8080
