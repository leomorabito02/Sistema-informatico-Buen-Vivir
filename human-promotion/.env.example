PORT=8085
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Mismo secreto HS256 que auth-service: este servicio solo valida tokens.
JWT_SECRET=

# Clave AES-256 de los campos confidenciales (32 bytes en base64).
# En Cloud Run: nombre del secreto en Secret Manager.
ENCRYPTION_KEY_SECRET=projects/<project-id>/secrets/human-promotion-enc-key/versions/latest
# Solo desarrollo local, si no se usa Secret Manager. Generar con:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Firestore: credenciales de la service account (path, JSON crudo o base64)
# o el emulador local.
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_APPLICATION_CREDENTIALS_BASE64=
# FIRESTORE_EMULATOR_HOST=localhost:8080
# GOOGLE_CLOUD_PROJECT=buenvivir-local

# Dirección gRPC de auth-service (nombre, edad y búsqueda de participantes).
AUTH_SERVICE_GRPC_TARGET=auth-service:50051
